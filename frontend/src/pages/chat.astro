---
import Layout from '../layouts/Layout.astro';

const chatApiUrl = import.meta.env.PUBLIC_CHAT_API_URL ?? 'http://localhost:3001/chat';
---

<Layout title="Ask Kitchen" description="Chat with Kitchen's cooking assistant — ask what to make with the ingredients you have, or get general cooking help.">
  <style>
    .chat-wrap {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      max-width: 760px;
      margin: 0 auto;
    }

    .chat-head {
      text-align: center;
      margin-bottom: 0.4rem;
    }

    .chat-title {
      font-family: var(--font-display);
      font-size: clamp(1.4rem, 3vw, 2rem);
      color: #fff3e4;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .chat-sub {
      color: rgba(255, 243, 228, 0.85);
      font-size: 1rem;
      margin-top: 0.3rem;
    }

    .chat-sheet {
      background:
        linear-gradient(160deg, rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0)),
        var(--paper);
      border: 1px solid var(--paper-edge);
      border-radius: var(--radius-md);
      box-shadow: 0 18px 24px rgba(54, 25, 8, 0.25);
      padding: clamp(1rem, 2vw, 1.6rem);
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
      min-height: 420px;
    }

    .messages {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      overflow-y: auto;
      max-height: 60vh;
      padding-right: 0.25rem;
    }

    .empty-state {
      color: var(--ink-muted);
      text-align: center;
      padding: 1.4rem 0 0.5rem;
      font-size: 0.98rem;
    }

    .suggestions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      margin-top: 0.9rem;
    }

    .suggestion {
      font-family: var(--font-body);
      font-size: 0.86rem;
      color: var(--ink);
      background: var(--paper-strong);
      border: 1px solid var(--paper-edge);
      padding: 0.45rem 0.85rem;
      border-radius: 999px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .suggestion:hover {
      background: var(--ink);
      color: var(--paper);
      border-color: var(--ink);
    }

    .msg {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .msg.user { align-items: flex-end; }
    .msg.assistant { align-items: flex-start; }

    .role-tag {
      font-family: var(--font-mono);
      font-size: 0.66rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }

    .bubble {
      max-width: 92%;
      padding: 0.7rem 1rem;
      border-radius: 14px;
      line-height: 1.5;
      font-size: 1rem;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    .msg.user .bubble {
      background: var(--ink);
      color: var(--paper);
      border-bottom-right-radius: 4px;
    }

    .msg.assistant .bubble {
      background: var(--paper-strong);
      color: var(--ink);
      border: 1px solid var(--paper-edge);
      border-bottom-left-radius: 4px;
    }

    .bubble :global(a) {
      color: inherit;
      text-decoration: underline;
      text-decoration-color: var(--accent);
      text-underline-offset: 2px;
    }

    .bubble :global(strong) { font-weight: 700; }

    .bubble.error {
      background: rgba(207, 60, 30, 0.08);
      border-color: rgba(207, 60, 30, 0.4);
      color: #8c2a10;
    }

    .composer {
      display: flex;
      gap: 0.5rem;
      align-items: flex-end;
    }

    .composer textarea {
      flex: 1;
      font-family: var(--font-body);
      font-size: 1rem;
      color: var(--ink);
      background: var(--paper-strong);
      border: 1px solid var(--paper-edge);
      border-radius: 12px;
      padding: 0.7rem 0.9rem;
      outline: none;
      resize: none;
      min-height: 48px;
      max-height: 160px;
      line-height: 1.4;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .composer textarea:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(239, 123, 63, 0.15);
    }

    .send-btn {
      font-family: var(--font-body);
      font-size: 0.86rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #fff3e4;
      background: var(--ink);
      border: none;
      border-radius: 999px;
      padding: 0.7rem 1.4rem;
      cursor: pointer;
      transition: background 0.2s ease;
    }

    .send-btn:hover:not(:disabled) { background: var(--accent); }
    .send-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .typing-dots::after {
      display: inline-block;
      content: '...';
      animation: dots 1.2s steps(3, end) infinite;
      width: 1.2em;
      overflow: hidden;
      vertical-align: bottom;
    }

    @keyframes dots {
      0% { width: 0; }
      100% { width: 1.2em; }
    }

    .footer-note {
      text-align: center;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: rgba(255, 243, 228, 0.7);
      margin-top: 0.4rem;
    }

    :global(html.dark) .chat-sheet {
      background: var(--paper);
      border-color: var(--paper-edge);
    }

    :global(html.dark) .bubble.error {
      background: rgba(207, 60, 30, 0.15);
      color: #f0915a;
    }
  </style>

  <div class="chat-wrap">
    <div class="chat-head">
      <p class="chat-title">Ask Kitchen</p>
      <p class="chat-sub">What can I make with what I have? Ask away.</p>
    </div>

    <div class="chat-sheet">
      <div class="messages" id="messages">
        <div class="empty-state" id="empty-state">
          <p>Ask about ingredients you have, a craving, or a technique.</p>
          <div class="suggestions">
            <button class="suggestion" type="button" data-prompt="What can I make with paneer and spinach?">paneer + spinach</button>
            <button class="suggestion" type="button" data-prompt="Quick weeknight dinner ideas">quick weeknight dinner</button>
            <button class="suggestion" type="button" data-prompt="Egg recipes under 15 minutes">eggs in 15 min</button>
            <button class="suggestion" type="button" data-prompt="What's a good substitute for buttermilk?">substitute for buttermilk</button>
          </div>
        </div>
      </div>

      <form class="composer" id="composer">
        <textarea
          id="input"
          placeholder="Type your question..."
          rows="1"
          autocomplete="off"
        ></textarea>
        <button class="send-btn" type="submit" id="send-btn">Send</button>
      </form>
    </div>

    <p class="footer-note">Replies are generated by Claude AI from <a href="https://www.anthropic.com" target="_blank" rel="noopener">Anthropic</a> using Vijaya's recipes — sometimes wrong, always trying.</p>
  </div>

  <script define:vars={{ chatApiUrl }}>
    const messagesEl = document.getElementById('messages');
    const emptyState = document.getElementById('empty-state');
    const form = document.getElementById('composer');
    const input = document.getElementById('input');
    const sendBtn = document.getElementById('send-btn');

    /** @type {{role: 'user'|'assistant', content: string}[]} */
    const history = [];

    function escapeHtml(s) {
      return s
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function renderMarkdown(text) {
      let html = escapeHtml(text);
      // links [text](/url) — only allow / or http(s) targets
      html = html.replace(/\[([^\]]+)\]\((\/[^\s)]*|https?:\/\/[^\s)]+)\)/g, (_, label, href) => {
        const isExternal = href.startsWith('http');
        const target = isExternal ? ' target="_blank" rel="noopener"' : '';
        return `<a href="${href}"${target}>${label}</a>`;
      });
      // bold **text**
      html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      return html;
    }

    function addMessage(role, text) {
      emptyState?.remove();
      const wrap = document.createElement('div');
      wrap.className = `msg ${role}`;
      const tag = document.createElement('span');
      tag.className = 'role-tag';
      tag.textContent = role === 'user' ? 'You' : 'Kitchen';
      const bubble = document.createElement('div');
      bubble.className = 'bubble';
      if (role === 'assistant') {
        bubble.innerHTML = renderMarkdown(text);
      } else {
        bubble.textContent = text;
      }
      wrap.appendChild(tag);
      wrap.appendChild(bubble);
      messagesEl.appendChild(wrap);
      messagesEl.scrollTop = messagesEl.scrollHeight;
      return bubble;
    }

    function setError(bubble, message) {
      bubble.classList.add('error');
      bubble.textContent = message;
    }

    async function send(promptText) {
      const text = promptText.trim();
      if (!text) return;

      input.value = '';
      input.style.height = 'auto';
      sendBtn.disabled = true;

      addMessage('user', text);
      history.push({ role: 'user', content: text });

      const replyBubble = addMessage('assistant', '');
      replyBubble.classList.add('typing-dots');

      let acc = '';
      let finished = false;

      try {
        const res = await fetch(chatApiUrl, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ messages: history }),
        });

        if (!res.ok || !res.body) {
          let detail = `HTTP ${res.status}`;
          try { const j = await res.json(); if (j.error) detail = j.error; } catch {}
          setError(replyBubble, `Couldn't reach Kitchen — ${detail}.`);
          history.pop();
          return;
        }

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });

          let idx;
          while ((idx = buffer.indexOf('\n\n')) !== -1) {
            const raw = buffer.slice(0, idx);
            buffer = buffer.slice(idx + 2);
            const line = raw.startsWith('data: ') ? raw.slice(6) : raw;
            if (!line) continue;
            let evt;
            try { evt = JSON.parse(line); } catch { continue; }
            if (evt.type === 'delta' && typeof evt.text === 'string') {
              if (acc === '') replyBubble.classList.remove('typing-dots');
              acc += evt.text;
              replyBubble.innerHTML = renderMarkdown(acc);
              messagesEl.scrollTop = messagesEl.scrollHeight;
            } else if (evt.type === 'error') {
              setError(replyBubble, evt.message);
              history.pop();
              return;
            } else if (evt.type === 'done') {
              finished = true;
            }
          }
        }

        if (acc) {
          history.push({ role: 'assistant', content: acc });
        } else if (!finished) {
          setError(replyBubble, 'No response received.');
          history.pop();
        }
      } catch (err) {
        setError(replyBubble, 'Network error — check your connection and try again.');
        history.pop();
      } finally {
        sendBtn.disabled = false;
        input.focus();
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      send(input.value);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form.requestSubmit();
      }
    });

    input.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 160) + 'px';
    });

    document.querySelectorAll('.suggestion').forEach((btn) => {
      btn.addEventListener('click', () => {
        send(btn.getAttribute('data-prompt') ?? '');
      });
    });
  </script>
</Layout>
