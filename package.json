{
  "name": "kitchen",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "bun --filter @kitchen/frontend dev",
    "dev:backend": "bun --filter @kitchen/backend dev",
    "dev": "bun --filter '*' dev",
    "build": "bun --filter @kitchen/frontend build",
    "build-index": "bun --filter @kitchen/backend build-index"
  }
}
