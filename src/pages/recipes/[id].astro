---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({
    params: { id: recipe.id.replace(/\.md$/, '') },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const { title, description, tags, image, calories, protein, servings, time } = recipe.data;

const emoji =
  (tags ?? []).includes('salad') ? '🥗' :
  (tags ?? []).includes('soup') ? '🍲' :
  (tags ?? []).includes('indian') ? '🍛' :
  (tags ?? []).includes('chicken') ? '🍗' :
  (tags ?? []).includes('vegan') ? '🌱' : '🍴';

const allRecipes = await getCollection('recipes');
const currentTags = tags ?? [];
const related = allRecipes
  .filter((r) => r.id !== recipe.id)
  .map((r) => ({
    recipe: r,
    score: (r.data.tags ?? []).filter((t) => currentTags.includes(t)).length,
  }))
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((r) => r.recipe);
---

<Layout title={title} description={description}>
  <style>
    .back {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #fff3e4;
      font-weight: 700;
      padding: 0.44rem 0.92rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 231, 194, 0.45);
      background: rgba(14, 58, 52, 0.32);
      margin-bottom: 0.95rem;
      transition: all 0.24s ease;
    }

    .back:hover {
      background: rgba(14, 58, 52, 0.78);
      border-color: rgba(255, 234, 206, 0.8);
    }

    .spread {
      --divider-x: 54%;
      background:
        linear-gradient(152deg, rgba(255, 255, 255, 0.44), rgba(255, 255, 255, 0)),
        var(--paper);
      border: 1px solid var(--paper-edge);
      border-radius: 14px;
      box-shadow: 0 18px 36px rgba(41, 19, 7, 0.34);
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      min-height: 70vh;
      position: relative;
      overflow: hidden;
      animation: enter-spread 500ms ease-out;
    }

    .spread::after {
      content: '';
      position: absolute;
      top: 1rem;
      bottom: 1rem;
      left: var(--divider-x);
      width: 1px;
      background: linear-gradient(
        to bottom,
        rgba(138, 121, 87, 0.2),
        rgba(87, 74, 43, 0.55) 46%,
        rgba(138, 121, 87, 0.2)
      );
      box-shadow: 0 0 11px rgba(0, 0, 0, 0.17);
    }

    .page-left,
    .page-right {
      padding-block: clamp(1rem, 2.3vw, 1.85rem);
      position: relative;
    }

    .page-left {
      padding-left: clamp(1rem, 2vw, 1.6rem);
      padding-right: clamp(1.65rem, 3.4vw, 2.45rem);
    }

    .page-right {
      padding-left: clamp(1.65rem, 3.4vw, 2.45rem);
      padding-right: clamp(1rem, 2vw, 1.6rem);
    }

    .page-left::before,
    .page-right::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        repeating-linear-gradient(0deg, rgba(74, 84, 64, 0.065), rgba(74, 84, 64, 0.065) 1px, transparent 1px, transparent 4px);
      opacity: 0.18;
      pointer-events: none;
    }

    .page-left > *,
    .page-right > * {
      position: relative;
      z-index: 1;
    }

    .recipe-image {
      width: 100%;
      height: clamp(250px, 43vh, 390px);
      object-fit: cover;
      border-radius: 10px;
      border: 1px solid rgba(97, 114, 92, 0.22);
      margin-bottom: 1.05rem;
    }

    .recipe-emoji {
      font-size: 3.2rem;
      line-height: 1;
      margin-bottom: 0.75rem;
      display: block;
    }

    .kicker {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--ink-muted);
      margin-bottom: 0.75rem;
    }

    h1 {
      font-family: var(--font-display);
      font-size: clamp(1.6rem, 4vw, 2.85rem);
      line-height: 1.05;
      margin-bottom: 0.75rem;
      text-transform: uppercase;
      text-wrap: balance;
      color: var(--ink);
      text-shadow: 2px 2px 0 rgba(250, 189, 157, 0.6);
    }

    .description {
      color: var(--ink-soft);
      font-size: 1rem;
      line-height: 1.35;
      margin-bottom: 1rem;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin-bottom: 0.7rem;
    }

    .tag {
      font-size: 0.62rem;
      font-weight: 700;
      padding: 0.2rem 0.56rem;
      border-radius: 999px;
      border: 1px solid #cbba91;
      background: rgba(253, 239, 215, 0.62);
      color: #315b53;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .nutrition-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 0.7rem;
      padding: 0.55rem 0.7rem;
      background: rgba(20, 72, 66, 0.07);
      border: 1px dashed rgba(92, 79, 53, 0.3);
      border-radius: 8px;
    }

    .nutrition-item {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--ink-soft);
    }

    .nutrition-item strong {
      color: var(--ink);
    }

    .nutrition-sep {
      color: var(--ink-muted);
      opacity: 0.5;
    }

    /* Markdown content */
    .content {
      font-size: 1.04rem;
      line-height: 1.45;
      color: #2d4a44;
    }

    .content h2 {
      font-family: var(--font-display);
      font-size: clamp(1.15rem, 3vw, 1.5rem);
      color: #a0461a;
      margin: 0 0 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      text-shadow: 1px 1px 0 rgba(253, 204, 176, 0.6);
      border-bottom: 1px dashed rgba(110, 95, 63, 0.35);
      padding-bottom: 0.3rem;
    }

    .content h2:not(:first-child) {
      margin-top: 1.35rem;
    }

    .content ul, .content ol {
      padding-left: 1.3rem;
      margin-bottom: 0.95rem;
    }

    .content li {
      margin-bottom: 0.42rem;
      font-size: 1rem;
      line-height: 1.5;
    }

    .content p {
      margin-bottom: 0.95rem;
      font-size: 1rem;
      line-height: 1.48;
    }

    .content strong {
      color: var(--ink);
      font-weight: 600;
    }

    .content hr {
      border: none;
      border-top: 1px dashed rgba(105, 90, 58, 0.4);
      margin: 1.3rem 0;
    }

    .content blockquote {
      border-left: 2px solid #c06c3f;
      padding: 0.3rem 0 0.3rem 0.8rem;
      color: #5a726a;
      margin: 0.8rem 0;
    }

    @keyframes enter-spread {
      from {
        transform: translateY(11px) scale(0.985);
        opacity: 0;
      }
      to {
        transform: translateY(0) scale(1);
        opacity: 1;
      }
    }

    @media (max-width: 960px) {
      .spread {
        grid-template-columns: 1fr;
      }

      .spread::after {
        display: none;
      }

      .page-left {
        padding: 1rem;
        border-bottom: 1px dashed rgba(103, 88, 58, 0.45);
      }

      .page-right {
        padding: 1rem;
      }
    }

    @media (max-width: 560px) {
      .content {
        font-size: 0.98rem;
      }
    }

    :global(html.dark) .spread {
      background: var(--paper);
      border-color: var(--paper-edge);
      box-shadow: 0 18px 36px rgba(0, 0, 0, 0.5);
    }

    :global(html.dark) .spread::after {
      background: linear-gradient(to bottom, rgba(255,255,255,0.05), rgba(255,255,255,0.12) 46%, rgba(255,255,255,0.05));
    }

    :global(html.dark) .page-left::before,
    :global(html.dark) .page-right::before {
      opacity: 0.05;
    }

    :global(html.dark) .content {
      color: #ddd8ce;
    }

    :global(html.dark) .content h2 {
      color: var(--accent);
      text-shadow: none;
      border-bottom-color: rgba(255, 255, 255, 0.12);
    }

    :global(html.dark) .content strong {
      color: #f0ece4;
    }

    :global(html.dark) .content blockquote {
      color: #b0a99d;
    }

    :global(html.dark) .content hr {
      border-top-color: rgba(255, 255, 255, 0.12);
    }

    :global(html.dark) .tag {
      background: rgba(255, 255, 255, 0.08);
      border-color: #444;
      color: #ccc5b9;
    }

    :global(html.dark) .nutrition-strip {
      background: rgba(255, 255, 255, 0.05);
      border-color: rgba(255, 255, 255, 0.12);
    }

    :global(html.dark) .kicker {
      color: var(--ink-muted);
    }


    .related-sheet {
      margin-top: 1.2rem;
      background:
        linear-gradient(152deg, rgba(255, 255, 255, 0.44), rgba(255, 255, 255, 0)),
        var(--paper);
      border: 1px solid var(--paper-edge);
      border-radius: 14px;
      box-shadow: 0 10px 22px rgba(72, 32, 11, 0.22);
      padding: clamp(1rem, 2.2vw, 1.7rem);
    }

    .related-header {
      margin-bottom: 0.8rem;
      border-bottom: 1px dashed rgba(92, 79, 53, 0.45);
      padding-bottom: 0.5rem;
    }

    .related-header h2 {
      font-family: var(--font-display);
      text-transform: uppercase;
      font-size: clamp(1.15rem, 2.2vw, 1.5rem);
      color: var(--ink);
      letter-spacing: 0.05em;
      margin: 0;
    }

    .related-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
    }

    .related-card {
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--paper-edge);
      background: var(--paper);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .related-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(72, 32, 11, 0.2);
    }

    .related-img {
      width: 100%;
      aspect-ratio: 4/3;
      object-fit: cover;
      display: block;
    }

    .related-placeholder {
      background: rgba(92, 79, 53, 0.1);
    }

    .related-title {
      display: block;
      padding: 0.5rem 0.6rem 0.2rem;
      font-family: var(--font-display);
      font-size: 0.82rem;
      text-transform: uppercase;
      color: var(--ink);
      line-height: 1.15;
    }

    .related-meta {
      display: block;
      padding: 0 0.6rem 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--ink-muted);
    }

    :global(html.dark) .related-sheet {
      background: var(--paper);
      border-color: var(--paper-edge);
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.4);
    }

    :global(html.dark) .related-header {
      border-bottom-color: rgba(255, 255, 255, 0.1);
    }

    :global(html.dark) .related-card {
      border-color: #333;
    }

    @media (max-width: 640px) {
      .related-grid {
        grid-template-columns: 1fr;
      }
    }

    .comments-sheet {
      margin-top: 1.2rem;
      background:
        linear-gradient(152deg, rgba(255, 255, 255, 0.44), rgba(255, 255, 255, 0)),
        var(--paper);
      border: 1px solid var(--paper-edge);
      border-radius: 14px;
      box-shadow: 0 10px 22px rgba(72, 32, 11, 0.22);
      padding: clamp(1rem, 2.2vw, 1.7rem);
      position: relative;
      overflow: hidden;
    }

    .comments-header {
      margin-bottom: 0.8rem;
      border-bottom: 1px dashed rgba(92, 79, 53, 0.45);
      padding-bottom: 0.5rem;
    }

    .comments-header h2 {
      font-family: var(--font-display);
      text-transform: uppercase;
      font-size: clamp(1.15rem, 2.2vw, 1.5rem);
      color: var(--ink);
      letter-spacing: 0.05em;
      margin: 0;
    }

    :global(html.dark) .comments-sheet {
      background: var(--paper);
      border-color: var(--paper-edge);
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.4);
    }

    :global(html.dark) .comments-header {
      border-bottom-color: rgba(255, 255, 255, 0.1);
    }

    .reading-progress {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      background: var(--accent, #ef7b3f);
      width: 0%;
      z-index: 999;
      transition: width 80ms linear;
    }

    @media print {
      .back, .lightbox, .print-btn, .share-btn, .reading-progress, .comments-sheet { display: none !important; }

      .spread {
        grid-template-columns: 1fr;
        box-shadow: none !important;
        border: none;
        border-radius: 0;
        min-height: auto;
        animation: none;
        background: #fff !important;
      }

      .spread::after { display: none; }

      .page-left::before, .page-right::before { display: none !important; }

      .page-left, .page-right {
        padding: 0;
      }

      .page-left {
        border-bottom: 1px solid #ccc;
        padding-bottom: 1rem;
        margin-bottom: 1rem;
      }

      .recipe-image {
        max-height: 250px;
        cursor: default;
      }

      .nutrition-strip {
        background: none;
        border: 1px solid #ccc;
      }

      .content { font-size: 0.95rem; }
    }

    .recipe-image {
      cursor: pointer;
    }

    .lightbox {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 1000;
      background: rgba(0, 0, 0, 0.75);
      align-items: center;
      justify-content: center;
      animation: fade-in 200ms ease-out;
    }

    .lightbox.open {
      display: flex;
    }

    .lightbox-close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: rgba(0, 0, 0, 0.5);
      border: none;
      color: #fff;
      font-size: 1.5rem;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s;
    }

    .lightbox-close:hover {
      background: rgba(0, 0, 0, 0.8);
    }

    .lightbox img {
      max-width: 90vw;
      max-height: 90vh;
      object-fit: contain;
      border-radius: 10px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }

    @keyframes fade-in {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  </style>

  <div class="reading-progress" id="reading-progress"></div>

  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.95rem;">
    <a class="back" style="margin-bottom:0;" href="/">← All recipes</a>
    <div style="display:flex;gap:0.4rem;">
      <button class="back share-btn" type="button" style="margin-bottom:0;cursor:pointer;"><svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:-2px;margin-right:3px;"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49" stroke="currentColor" stroke-width="2.5"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49" stroke="currentColor" stroke-width="2.5"/></svg>Share</button>
      <button class="back print-btn" type="button" onclick="window.print()" style="margin-bottom:0;cursor:pointer;">Print recipe</button>
    </div>
  </div>

  <article class="spread">
    <section class="page-left">
      {image
        ? <img class="recipe-image" src={image} alt={title} />
        : <span class="recipe-emoji">{emoji}</span>
      }
      <p class="kicker">Recipe Sheet</p>
      <h1>{title}</h1>
      <p class="description">{description}</p>

      {tags && (
        <div class="tags">
          {tags.map((tag) => <a class="tag" href={`/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}
        </div>
      )}

      {(calories || protein || servings || time) && (
        <div class="nutrition-strip">
          {time && <span class="nutrition-item"><strong>{time}</strong></span>}
          {time && servings && <span class="nutrition-sep">·</span>}
          {servings && <span class="nutrition-item"><strong>{servings}</strong> servings</span>}
          {(time || servings) && (calories || protein) && <span class="nutrition-sep">·</span>}
          {calories && <span class="nutrition-item"><strong>{calories}</strong>/serving</span>}
          {calories && protein && <span class="nutrition-sep">·</span>}
          {protein && <span class="nutrition-item"><strong>{protein}</strong> protein</span>}
        </div>
      )}
    </section>

    <section class="page-right">
      <div class="content">
        <Content />
      </div>
    </section>
  </article>

  {related.length > 0 && (
    <section class="related-sheet">
      <div class="related-header">
        <h2>You might also like</h2>
      </div>
      <div class="related-grid">
        {related.map((r) => (
          <a class="related-card" href={`/recipes/${r.id.replace(/\.md$/, '')}/`}>
            {r.data.image
              ? <img class="related-img" src={r.data.image} alt={r.data.title} loading="lazy" />
              : <div class="related-img related-placeholder"></div>
            }
            <span class="related-title">{r.data.title}</span>
            {r.data.time && <span class="related-meta">{r.data.time}</span>}
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="comments-sheet">
    <div class="comments-header">
      <h2>Comments</h2>
    </div>
    <div id="giscus-container">
      <script
        src="https://giscus.app/client.js"
        data-repo="vijaya22/kitchen"
        data-repo-id="R_kgDORgGBAQ"
        data-category="General"
        data-category-id="DIC_kwDORgGBAc4C7Sl4"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="light"
        data-lang="en"
        crossorigin="anonymous"
        async
      ></script>
    </div>
  </section>

  {image && (
    <div class="lightbox" id="lightbox">
      <button class="lightbox-close" id="lightbox-close" aria-label="Close preview">✕</button>
      <img src={image} alt={title} />
    </div>
  )}

  <script>
    const img = document.querySelector('.recipe-image') as HTMLImageElement;
    const lightbox = document.getElementById('lightbox');
    const closeBtn = document.getElementById('lightbox-close');

    if (img && lightbox && closeBtn) {
      img.addEventListener('click', () => lightbox.classList.add('open'));
      closeBtn.addEventListener('click', () => lightbox.classList.remove('open'));
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) lightbox.classList.remove('open');
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') lightbox.classList.remove('open');
      });
    }

    // Sync giscus theme with dark mode
    function setGiscusTheme(dark: boolean) {
      const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      if (iframe) {
        iframe.contentWindow?.postMessage(
          { giscus: { setConfig: { theme: dark ? 'dark' : 'light' } } },
          'https://giscus.app'
        );
      }
    }

    // Set correct theme before giscus loads
    if (document.documentElement.classList.contains('dark')) {
      const giscusScript = document.querySelector('script[src*="giscus.app"]');
      if (giscusScript) giscusScript.setAttribute('data-theme', 'dark');
    }

    // Sync on toggle
    const observer = new MutationObserver(() => {
      setGiscusTheme(document.documentElement.classList.contains('dark'));
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    // Sync when giscus iframe loads
    window.addEventListener('message', (e) => {
      if (e.origin !== 'https://giscus.app') return;
      if (typeof e.data !== 'object' || !e.data.giscus) return;
      setGiscusTheme(document.documentElement.classList.contains('dark'));
    });

    // Reading progress
    const progressBar = document.getElementById('reading-progress')!;
    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = `${Math.min(progress, 100)}%`;
    });

    // Share button
    const shareBtn = document.querySelector('.share-btn') as HTMLButtonElement;
    if (shareBtn) {
      shareBtn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(window.location.href);
        const toast = document.createElement('div');
        toast.textContent = 'Link copied!';
        Object.assign(toast.style, {
          position: 'absolute',
          top: '100%',
          right: '0',
          marginTop: '0.4rem',
          background: getComputedStyle(document.documentElement).getPropertyValue('--paper').trim() || '#f6f1df',
          color: getComputedStyle(document.documentElement).getPropertyValue('--ink').trim() || '#204f49',
          fontFamily: "'Special Elite', 'Courier New', monospace",
          fontSize: '0.72rem',
          letterSpacing: '0.05em',
          textTransform: 'uppercase',
          padding: '0.45rem 0.8rem',
          borderRadius: '10px',
          border: `1px solid ${getComputedStyle(document.documentElement).getPropertyValue('--paper-edge').trim() || '#d4c49d'}`,
          boxShadow: '0 6px 18px rgba(0, 0, 0, 0.2)',
          zIndex: '1001',
          opacity: '0',
          transform: 'translateY(-4px)',
          transition: 'opacity 0.25s ease, transform 0.25s ease',
          pointerEvents: 'none',
          whiteSpace: 'nowrap',
        });
        shareBtn.style.position = 'relative';
        shareBtn.appendChild(toast);
        requestAnimationFrame(() => {
          toast.style.opacity = '1';
          toast.style.transform = 'translateY(0)';
        });
        setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(-4px)';
          setTimeout(() => toast.remove(), 250);
        }, 2000);
      });
    }
  </script>
</Layout>
