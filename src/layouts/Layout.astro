---
import { getCollection } from 'astro:content';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
}
const siteUrl = 'https://kitchen.vijaya.io';
const { title, description = "Vijaya's kitchen — a collection of recipes.", image, url } = Astro.props;
const ogImage = image ? `${siteUrl}${image}` : `${siteUrl}/images/burrata-garden-sourdough-toast.png`;
const ogUrl = url ? `${siteUrl}${url}` : siteUrl;

const recipes = (await getCollection('recipes')).map((r) => ({
  title: r.data.title,
  tags: r.data.tags ?? [],
  url: `/recipes/${r.id.replace(/\.md$/, '')}/`,
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={ogUrl} />
    <link rel="alternate" type="application/rss+xml" title="Vijaya's Kitchen" href="/rss.xml" />
    <title>{title} — Kitchen</title>
    <ViewTransitions />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — Kitchen`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="Vijaya's Kitchen" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Kitchen`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:wght@400;500;700&family=Rye&family=Special+Elite&display=swap" rel="stylesheet" />

    <script is:inline>
      if (localStorage.getItem('theme') === 'dark') document.documentElement.classList.add('dark');
    </script>
    <style>
      :root {
        --scene-bg: #e2e3de;
        --orange-400: #f44b14;
        --orange-500: #e8400d;
        --orange-600: #cd3002;
        --paper: #f6f1df;
        --paper-strong: #ece3c8;
        --paper-edge: #d4c49d;
        --ink: #204f49;
        --ink-soft: #487067;
        --ink-muted: #6f857d;
        --accent: #ef7b3f;
        --gold: #c79f2d;
        --shadow: rgba(40, 21, 9, 0.22);
        --font-display: 'Rye', Georgia, serif;
        --font-body: 'Alegreya Sans', 'Trebuchet MS', sans-serif;
        --font-mono: 'Special Elite', 'Courier New', monospace;
        --radius-lg: 24px;
        --radius-md: 14px;
      }

      html.dark {
        --scene-bg: #121212;
        --orange-400: #e84a14;
        --orange-500: #d4400d;
        --orange-600: #b83306;
        --paper: #1e1e1e;
        --paper-strong: #171717;
        --paper-edge: #333;
        --ink: #f0ece4;
        --ink-soft: #ccc5b9;
        --ink-muted: #8a8479;
        --accent: #f0915a;
        --gold: #d4af37;
        --shadow: rgba(0, 0, 0, 0.5);
      }

      html.dark body {
        background: radial-gradient(circle at top, #1a1a1a 0%, var(--scene-bg) 56%, #0d0d0d 100%);
      }

      html.dark header {
        background: rgba(30, 30, 30, 0.96);
        border-color: #333;
      }

      html.dark header nav a {
        border-color: #444;
        color: var(--ink-soft);
      }

      html.dark header nav a:hover {
        background: var(--ink);
        color: #1e1e1e;
      }

      html.dark .search-results {
        background: var(--paper);
        border-color: var(--paper-edge);
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background: radial-gradient(circle at top, #f7f7f3 0%, var(--scene-bg) 56%, #d7d8d2 100%);
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 1.125rem;
        line-height: 1.45;
        min-height: 100vh;
      }

      a { color: inherit; text-decoration: none; }

      header {
        width: min(1260px, calc(100% - 2.4rem));
        margin: 1rem auto 0.8rem;
        background: rgba(248, 246, 239, 0.95);
        border: 1px solid #ded8c3;
        border-radius: 999px;
        padding: 0.75rem 1rem 0.75rem 1.35rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        box-shadow: 0 8px 24px rgba(58, 39, 14, 0.1);
        position: relative;
      }

      .site-name {
        font-family: var(--font-display);
        font-size: clamp(1.05rem, 2vw, 1.35rem);
        letter-spacing: 0.04em;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .site-name span {
        font-size: 1.25rem;
        transform: rotate(-6deg);
      }

      header nav a {
        font-size: 0.82rem;
        color: var(--ink-soft);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 700;
        padding: 0.46rem 1.05rem;
        border-radius: 999px;
        border: 1px solid #c9b98f;
        transition: all 0.25s ease;
      }

      header nav a:hover {
        background: var(--ink);
        border-color: var(--ink);
        color: #fdf8eb;
      }

      .theme-toggle {
        width: 34px;
        height: 34px;
        border-radius: 999px;
        border: 1px solid #c9b98f;
        background: transparent;
        cursor: pointer;
        font-size: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.25s ease;
        flex-shrink: 0;
      }

      .theme-toggle::after {
        content: '🌙';
      }

      html.dark .theme-toggle {
        border-color: #4a5248;
      }

      html.dark .theme-toggle::after {
        content: '☀️';
      }

      .theme-toggle:hover {
        background: var(--ink);
        border-color: var(--ink);
      }

      .header-default {
        display: contents;
      }

      header.searching .header-default {
        display: none;
      }

      .search-input {
        display: none;
        flex: 1;
        border: none;
        background: transparent;
        font-family: var(--font-body);
        font-size: 1.05rem;
        color: var(--ink);
        outline: none;
        min-width: 0;
      }

      .search-input::placeholder {
        color: var(--ink-muted);
      }

      header.searching .search-input {
        display: block;
      }

      header.searching {
        cursor: text;
      }

      .search-results {
        display: none;
        position: absolute;
        top: calc(100% + 0.5rem);
        left: 0;
        right: 0;
        background:
          linear-gradient(150deg, rgba(255, 255, 255, 0.44), rgba(255, 255, 255, 0)),
          var(--paper);
        border: 1px solid var(--paper-edge);
        border-radius: 14px;
        padding: 0.6rem 0.75rem;
        box-shadow: 0 10px 22px rgba(72, 32, 11, 0.22);
        max-height: 320px;
        overflow-y: auto;
        z-index: 20;
        list-style: none;
      }

      .search-results.open {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }

      :global(.search-results a) {
        display: block;
        padding: 0.4rem 0.5rem;
        border-radius: 8px;
        font-family: var(--font-display);
        font-size: clamp(0.9rem, 1.8vw, 1.08rem);
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        transition: color 0.2s ease, background 0.2s ease;
      }

      :global(.search-results a:hover) {
        color: #a33d0f;
        background: rgba(32, 79, 73, 0.06);
      }

      :global(.search-results .no-results) {
        padding: 0.4rem 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.76rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--ink-muted);
      }

      main {
        width: min(1260px, calc(100% - 2.4rem));
        margin: 0 auto 2.4rem;
        padding: clamp(1.2rem, 2vw, 2.2rem);
        background: linear-gradient(145deg, var(--orange-400), var(--orange-500) 55%, var(--orange-600));
        border-radius: var(--radius-lg);
        position: relative;
        overflow: hidden;
        box-shadow: 0 22px 44px var(--shadow), inset 0 0 0 1px rgba(247, 175, 140, 0.24);
        animation: stage-enter 480ms ease-out;
      }

      main::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
          radial-gradient(circle at 18% 14%, rgba(255, 170, 139, 0.22) 0 3px, transparent 3px),
          radial-gradient(circle at 74% 36%, rgba(255, 193, 161, 0.12) 0 2px, transparent 2px),
          linear-gradient(35deg, rgba(190, 35, 5, 0.16), transparent 45%);
        background-size: 240px 240px, 190px 190px, 100% 100%;
        mix-blend-mode: soft-light;
        pointer-events: none;
      }

      main > * {
        position: relative;
        z-index: 1;
      }

      @keyframes stage-enter {
        from {
          transform: translateY(12px);
          opacity: 0;
        }
        to {
          transform: translateY(0);
          opacity: 1;
        }
      }

      footer {
        width: min(1260px, calc(100% - 2.4rem));
        margin: 0 auto 1.6rem;
        padding: 0.75rem 1.35rem;
        text-align: center;
      }

      .footer-note {
        font-family: var(--font-mono);
        font-size: 0.76rem;
        letter-spacing: 0.03em;
        color: var(--ink-muted);
      }

      .footer-note a {
        color: var(--ink);
        font-weight: 700;
        border-bottom: 1px dashed var(--ink-muted);
        transition: color 0.2s ease, border-color 0.2s ease;
      }

      .footer-note a:hover {
        color: var(--accent);
        border-color: var(--accent);
      }

      @media print {
        header, footer { display: none !important; }

        main {
          background: none;
          box-shadow: none;
          padding: 1rem;
          margin: 0;
          width: 100%;
          border-radius: 0;
          animation: none;
          border: 3px solid var(--orange-400);
        }

        main::before { display: none; }

        body {
          background: #fff;
          color: #000;
        }
      }

      @media (max-width: 720px) {
        header {
          width: calc(100% - 1.4rem);
          margin: 0.7rem auto;
          border-radius: 18px;
          padding: 0.65rem 0.8rem;
        }

        .site-name {
          font-size: 0.92rem;
          letter-spacing: 0.03em;
        }

        header nav a {
          padding: 0.4rem 0.72rem;
          font-size: 0.72rem;
        }

        main {
          width: calc(100% - 1.4rem);
          margin-bottom: 1rem;
          border-radius: 20px;
          padding: 1rem;
        }

        footer {
          width: calc(100% - 1.4rem);
          margin-bottom: 1rem;
          padding: 0.6rem 0.8rem;
        }

        .footer-note {
          font-size: 0.68rem;
        }
      }
    </style>
  </head>
  <body>
    <header id="header">
      <div class="header-default">
        <a class="site-name" href="/">
          <span>🍳</span> Kitchen
        </a>
        <nav style="display:flex;align-items:center;gap:0.5rem;">
          <a href="/">All recipes</a>
          <a href="/about">About</a>
          <a href="/request">Request</a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode"></button>
        </nav>
      </div>
      <input class="search-input" id="search-input" type="text" placeholder="Search recipes..." autocomplete="off" />
      <div class="search-results" id="search-results"></div>
    </header>

    <script define:vars={{ recipes }}>
      const header = document.getElementById('header');
      const input = document.getElementById('search-input');
      const resultsEl = document.getElementById('search-results');

      function openSearch() {
        header.classList.add('searching');
        input.focus();
      }

      function closeSearch() {
        header.classList.remove('searching');
        resultsEl.classList.remove('open');
        input.value = '';
      }

      header.addEventListener('click', (e) => {
        if (e.target.closest('a')) return;
        if (!header.classList.contains('searching')) openSearch();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeSearch();
      });

      input.addEventListener('input', () => {
        const query = input.value.trim().toLowerCase();
        if (!query) {
          resultsEl.classList.remove('open');
          return;
        }

        const matches = recipes.filter((r) => {
          const haystack = (r.title + ' ' + r.tags.join(' ')).toLowerCase();
          return query.split(/\s+/).every((word) => haystack.includes(word));
        });

        if (matches.length > 0) {
          resultsEl.innerHTML = matches
            .map((r) => `<a href="${r.url}">${r.title}</a>`)
            .join('');
        } else {
          resultsEl.innerHTML = '<div class="no-results">No recipes found</div>';
        }
        resultsEl.classList.add('open');
      });

      document.addEventListener('click', (e) => {
        if (!e.target.closest('header')) closeSearch();
      });
    </script>
    <script>
      const toggle = document.getElementById('theme-toggle')!;
      toggle.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>
    <main transition:animate="fade">
      <slot />
    </main>
    <footer>
      <p class="footer-note">If you like my recipes and feel like supporting me, <a href="https://buymeacoffee.com/vijaya.laxmi" target="_blank" rel="noopener noreferrer">buy me a coffee here</a>.</p>
    </footer>
  </body>
</html>
