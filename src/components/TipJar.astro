---
interface Props {
  message?: string;
  cta?: string;
  href?: string;
}

const {
  message = 'Loved this recipe?',
  cta = 'Buy me a coffee',
  href = 'https://buymeacoffee.com/vijaya.laxmi',
} = Astro.props;
---

<aside class="tipjar">
  <span class="tipjar-emoji" aria-hidden="true">&#x2615;</span>
  <p class="tipjar-text">{message}</p>
  <a class="tipjar-link" href={href} target="_blank" rel="noopener noreferrer">{cta}</a>
</aside>

<style>
  .tipjar {
    margin-top: 0.8rem;
    padding: 0.7rem 1rem;
    background: rgba(20, 72, 66, 0.07);
    border: 1px dashed rgba(92, 79, 53, 0.35);
    border-radius: 999px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
  }

  .tipjar-emoji {
    font-size: 1.1rem;
    line-height: 1;
  }

  .tipjar-text {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  .tipjar-link {
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--ink);
    padding: 0.36rem 0.95rem;
    border: 1px solid var(--paper-edge);
    border-radius: 999px;
    background: var(--paper);
    transition: background 0.22s ease, color 0.22s ease, border-color 0.22s ease;
    white-space: nowrap;
  }

  .tipjar-link:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  :global(html.dark) .tipjar {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.15);
  }

  :global(html.dark) .tipjar-link {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.15);
    color: var(--ink);
  }

  :global(html.dark) .tipjar-link:hover {
    background: var(--accent);
    color: #111;
    border-color: var(--accent);
  }
</style>
