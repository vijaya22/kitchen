---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  title: string;
  note?: string;
  image?: ImageMetadata;
  recipe?: string;
}

interface Props {
  items: Item[];
  heading?: string;
}

const { items, heading = 'Ways to serve' } = Astro.props;

const slugify = (t: string) =>
  t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const seen = new Map<string, number>();
const withIds = await Promise.all(items.map(async (item) => {
  const base = slugify(item.title) || 'serve';
  const n = seen.get(base) ?? 0;
  seen.set(base, n + 1);
  const large = item.image ? (await getImage({ src: item.image, width: 1440 })).src : undefined;
  return { ...item, id: n ? `${base}-${n + 1}` : base, large };
}));
---

<section class="serve-sheet">
  <div class="serve-header">
    <h2>{heading}</h2>
  </div>
  <div class="serve-grid">
    {withIds.map((item) => (
      <div class="serve-card" id={item.id}>
        {item.image && (
          <div class="serve-img-wrap">
            <Image class="serve-img" src={item.image} alt={item.title} widths={[320, 640]} sizes="(max-width: 720px) 90vw, 320px" loading="lazy" />
            <button class="serve-copy" type="button" aria-label={`Copy link to ${item.title}`} data-id={item.id}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5" />
                <path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5" />
              </svg>
            </button>
            <span class="serve-toast" role="status" aria-live="polite">Link copied!</span>
            <button class="serve-zoom" type="button" aria-label="View larger image" data-src={item.large} data-alt={item.title}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
                <line x1="11" y1="8" x2="11" y2="14" />
                <line x1="8" y1="11" x2="14" y2="11" />
              </svg>
            </button>
          </div>
        )}
        <span class="serve-title">{item.title}</span>
        {item.note && <span class="serve-note">{item.note}</span>}
        {item.recipe && <a class="serve-link" href={`/recipes/${item.recipe}/`}>View recipe →</a>}
      </div>
    ))}
  </div>
</section>

<div class="serve-lightbox" id="serve-lightbox">
  <button class="serve-lightbox-close" type="button" aria-label="Close">&times;</button>
  <img src="" alt="" />
</div>

<script>
  function initServe() {
    const lightbox = document.getElementById('serve-lightbox');
    if (!lightbox) return;
    const lightboxImg = lightbox.querySelector('img') as HTMLImageElement | null;
    const lightboxClose = lightbox.querySelector('.serve-lightbox-close');
    if (!lightboxImg) return;

    function open(btn: HTMLElement) {
      const src = btn.dataset.src;
      if (!src) return;
      lightboxImg!.src = src;
      lightboxImg!.alt = btn.dataset.alt ?? '';
      lightbox!.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    document.querySelectorAll<HTMLElement>('.serve-zoom').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        open(btn);
      });
      // Tapping the photo itself also opens the preview (no hover on touch screens)
      btn.closest('.serve-img-wrap')?.addEventListener('click', () => open(btn));
    });

    document.querySelectorAll<HTMLElement>('.serve-copy').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const url = `${window.location.origin}${window.location.pathname}#${btn.dataset.id}`;
        const toast = btn.parentElement?.querySelector<HTMLElement>('.serve-toast');
        try {
          await navigator.clipboard.writeText(url);
          if (toast) toast.textContent = 'Link copied!';
        } catch {
          if (toast) toast.textContent = 'Copy failed';
        }
        if (toast) {
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 1600);
        }
      });
    });

    function close() {
      lightbox!.classList.remove('open');
      document.body.style.overflow = '';
    }

    lightboxClose?.addEventListener('click', close);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }

  document.addEventListener('astro:page-load', initServe);
</script>

<style>
  .serve-sheet {
    margin-top: 1.2rem;
    background:
      linear-gradient(152deg, rgba(255, 255, 255, 0.44), rgba(255, 255, 255, 0)),
      var(--paper);
    border: 1px solid var(--paper-edge);
    border-radius: 14px;
    box-shadow: 0 10px 22px rgba(72, 32, 11, 0.22);
    padding: clamp(1rem, 2.2vw, 1.7rem);
  }
  .serve-header {
    margin-bottom: 0.8rem;
    border-bottom: 1px dashed rgba(92, 79, 53, 0.45);
    padding-bottom: 0.5rem;
  }
  .serve-header h2 {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    color: var(--ink);
    letter-spacing: 0.05em;
    margin: 0;
  }
  :global(html.dark) .serve-sheet {
    background: var(--paper);
    border-color: var(--paper-edge);
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.4);
  }
  :global(html.dark) .serve-header {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }
  .serve-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }
  .serve-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .serve-link { font-size: 0.9em; font-weight: 700; color: inherit; }
  .serve-card { scroll-margin-top: 1.5rem; }
  .serve-card:target {
    outline: 2px solid currentColor;
    outline-offset: 6px;
    border-radius: 10px;
  }
  .serve-img-wrap {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    border: 2px solid rgba(92, 79, 53, 0.2);
    cursor: zoom-in;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .serve-img-wrap:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(72, 32, 11, 0.25);
  }
  .serve-img-wrap:hover .serve-img { transform: scale(1.05); }
  :global(html.dark) .serve-img-wrap { border-color: rgba(255, 255, 255, 0.1); }
  .serve-zoom {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease, background 0.2s ease, transform 0.2s ease;
    z-index: 2;
    padding: 0;
  }
  .serve-copy {
    position: absolute;
    top: 0.45rem;
    left: 0.45rem;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease, background 0.2s ease, transform 0.2s ease;
    z-index: 2;
    padding: 0;
  }
  .serve-copy:hover { background: rgba(0, 0, 0, 0.85); transform: scale(1.08); }
  .serve-toast {
    position: absolute;
    top: 0.5rem;
    left: 2.6rem;
    z-index: 3;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.35rem 0.65rem;
    border-radius: 8px;
    border: 1px solid var(--paper-edge);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .serve-toast.show { opacity: 1; }
  .serve-img-wrap:hover .serve-zoom,
  .serve-img-wrap:hover .serve-copy,
  .serve-zoom:focus-visible,
  .serve-copy:focus-visible { opacity: 1; }
  @media (hover: none) {
    .serve-zoom, .serve-copy { opacity: 1; }
  }
  .serve-zoom:hover { background: rgba(0, 0, 0, 0.85); transform: scale(1.08); }
  .serve-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s ease; }
  .serve-title { font-weight: 700; }
  .serve-note { font-size: 0.9em; opacity: 0.8; }
  @media (max-width: 720px) {
    .serve-grid { grid-template-columns: 1fr; }
  }
  .serve-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.8);
    align-items: center;
    justify-content: center;
    animation: serve-fade-in 200ms ease-out;
  }
  .serve-lightbox.open { display: flex; }
  .serve-lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(0, 0, 0, 0.5);
    border: none;
    color: #fff;
    font-size: 1.5rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    z-index: 1001;
  }
  .serve-lightbox-close:hover { background: rgba(0, 0, 0, 0.8); }
  .serve-lightbox img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 10px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }
  @keyframes serve-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media print { .serve-lightbox { display: none !important; } }
</style>
