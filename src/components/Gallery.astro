---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
  href: string;
}

interface Props {
  items: GalleryItem[];
  heading?: string;
  totalCount?: number;
  viewAllHref?: string;
}

const { items, heading = 'Photo Gallery', totalCount, viewAllHref } = Astro.props;
const countLabel = totalCount !== undefined && totalCount !== items.length
  ? `${items.length} of ${totalCount} Photos`
  : `${items.length} Photos`;
---

<section class="gallery-sheet">
  <div class="gallery-header">
    <h2>{heading}</h2>
    <span>{countLabel}</span>
  </div>
  <div class="gallery-grid">
    {items.map((img) => (
      <div class="gallery-item">
        <a class="gallery-link" href={img.href}>
          <Image src={img.image} alt={img.alt} widths={[240, 480]} sizes="(max-width: 720px) 40vw, 240px" loading="lazy" />
          <span class="gallery-caption">{img.alt}</span>
        </a>
        <button class="gallery-zoom" type="button" aria-label="View larger image" data-src={img.image.src} data-alt={img.alt}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
            <line x1="11" y1="8" x2="11" y2="14" />
            <line x1="8" y1="11" x2="14" y2="11" />
          </svg>
        </button>
      </div>
    ))}
  </div>
  {viewAllHref && (
    <div class="gallery-footer">
      <a class="gallery-view-all" href={viewAllHref}>View all photos →</a>
    </div>
  )}
</section>

<div class="gallery-lightbox" id="gallery-lightbox">
  <button class="gallery-lightbox-close" type="button" aria-label="Close">&times;</button>
  <img src="" alt="" />
</div>

<script>
  function initGallery() {
    const lightbox = document.getElementById('gallery-lightbox');
    if (!lightbox) return;
    const lightboxImg = lightbox.querySelector('img') as HTMLImageElement | null;
    const lightboxClose = lightbox.querySelector('.gallery-lightbox-close');
    if (!lightboxImg) return;

    document.querySelectorAll<HTMLElement>('.gallery-zoom').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const src = btn.dataset.src;
        const alt = btn.dataset.alt ?? '';
        if (!src) return;
        lightboxImg.src = src;
        lightboxImg.alt = alt;
        lightbox.classList.add('open');
        document.body.style.overflow = 'hidden';
      });
    });

    function close() {
      lightbox!.classList.remove('open');
      document.body.style.overflow = '';
    }

    lightboxClose?.addEventListener('click', close);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }

  document.addEventListener('astro:page-load', initGallery);
</script>

<style>
  .gallery-sheet {
    margin-top: 1.2rem;
    background:
      linear-gradient(150deg, rgba(255, 255, 255, 0.44), rgba(255, 255, 255, 0)),
      var(--paper);
    border: 1px solid var(--paper-edge);
    border-radius: 12px;
    box-shadow: 0 10px 22px rgba(72, 32, 11, 0.22);
    padding: clamp(1rem, 2.2vw, 1.7rem);
    position: relative;
    overflow: hidden;
  }

  .gallery-sheet::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(0deg, rgba(66, 79, 56, 0.06), rgba(66, 79, 56, 0.06) 1px, transparent 1px, transparent 4px);
    opacity: 0.12;
    pointer-events: none;
  }

  .gallery-sheet > * {
    position: relative;
    z-index: 1;
  }

  .gallery-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.8rem;
    border-bottom: 1px dashed rgba(92, 79, 53, 0.45);
    padding-bottom: 0.5rem;
  }

  .gallery-header h2 {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    color: var(--ink);
    letter-spacing: 0.05em;
    margin: 0;
  }

  .gallery-header span {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.68rem;
    color: var(--ink-muted);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .gallery-item {
    position: relative;
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
    border: 2px solid rgba(92, 79, 53, 0.2);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .gallery-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(72, 32, 11, 0.25);
  }

  .gallery-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  .gallery-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0.5rem 0.6rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #fff;
    text-align: left;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }

  .gallery-item:hover .gallery-caption {
    opacity: 1;
  }

  .gallery-zoom {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: none;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease, background 0.2s ease, transform 0.2s ease;
    z-index: 2;
    padding: 0;
  }

  .gallery-item:hover .gallery-zoom,
  .gallery-zoom:focus-visible {
    opacity: 1;
  }

  .gallery-zoom:hover {
    background: rgba(0, 0, 0, 0.85);
    transform: scale(1.08);
  }

  .gallery-footer {
    margin-top: 1rem;
    text-align: center;
  }

  .gallery-view-all {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--ink);
    padding: 0.5rem 1.2rem;
    border: 1px solid var(--paper-edge);
    border-radius: 999px;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  .gallery-view-all:hover {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .gallery-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: rgba(0, 0, 0, 0.8);
    align-items: center;
    justify-content: center;
    animation: gallery-fade-in 200ms ease-out;
  }

  .gallery-lightbox.open {
    display: flex;
  }

  .gallery-lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(0, 0, 0, 0.5);
    border: none;
    color: #fff;
    font-size: 1.5rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    z-index: 1001;
  }

  .gallery-lightbox-close:hover {
    background: rgba(0, 0, 0, 0.8);
  }

  .gallery-lightbox img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 10px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  @keyframes gallery-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  :global(html.dark) .gallery-sheet {
    background: var(--paper);
    border-color: var(--paper-edge);
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.4);
  }

  :global(html.dark) .gallery-sheet::before { opacity: 0.03; }

  :global(html.dark) .gallery-header {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  :global(html.dark) .gallery-item {
    border-color: rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 930px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .gallery-caption {
      font-size: 0.58rem;
      padding: 0.35rem 0.45rem;
      opacity: 1;
    }

    .gallery-zoom {
      opacity: 1;
      width: 28px;
      height: 28px;
    }
  }
</style>
